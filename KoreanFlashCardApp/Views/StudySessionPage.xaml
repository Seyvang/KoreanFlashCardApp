<?xml version="1.0" encoding="utf-8" ?>
<controls:BasePage
    x:Class="KoreanFlashCardApp.StudySessionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:KoreanFlashCardApp.Controls"
    xmlns:models="clr-namespace:KoreanFlashCardApp.Models"
    xmlns:viewModels="clr-namespace:KoreanFlashCardApp.ViewModels"
    x:Name="SessionPageRoot"
    x:DataType="viewModels:StudySessionPageViewModel"
    BackgroundColor="#F3EDE2"
    Shell.NavBarIsVisible="False">

    <Grid Padding="20,24,20,20" RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <Button
                Padding="16,10"
                BackgroundColor="#E5DBCE"
                Command="{Binding ReturnToModulesCommand}"
                CornerRadius="18"
                FontAttributes="Bold"
                Text="Modules"
                TextColor="#3A332D" />
            <VerticalStackLayout
                Grid.Column="1"
                Margin="16,0,0,0"
                Spacing="2">
                <Label
                    FontAttributes="Bold"
                    FontSize="26"
                    Text="{Binding SessionTitle}"
                    TextColor="#1E1B18" />
                <Label
                    FontSize="14"
                    Text="{Binding SessionSubtitle}"
                    TextColor="#645A4E" />
            </VerticalStackLayout>
        </Grid>

        <controls:WordDefinitionHeader
            Grid.Row="1"
            Margin="0,20,0,18"
            IsVisible="{Binding HasCard}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="18">
                <VerticalStackLayout IsVisible="{Binding HasCard}" Spacing="18">
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Select the best English definition"
                        TextColor="#1E1B18" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Options}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:FlashCardOption">
                                <Border
                                    Padding="0"
                                    Background="{Binding BackgroundColor}"
                                    Stroke="{Binding BorderColor}"
                                    StrokeShape="RoundRectangle 20">
                                    <Button
                                        Padding="18,16"
                                        BackgroundColor="Transparent"
                                        Command="{Binding BindingContext.SelectOptionCommand, Source={x:Reference SessionPageRoot}}"
                                        CommandParameter="{Binding .}"
                                        FontSize="16"
                                        IsEnabled="{Binding IsEnabled}"
                                        Text="{Binding Text}"
                                        TextColor="{Binding TextColor}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Border
                        Padding="18"
                        Background="#FBF8F2"
                        Stroke="#D8CCBB"
                        StrokeShape="RoundRectangle 22"
                        IsVisible="{Binding ShowFeedback}">
                        <VerticalStackLayout Spacing="12">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="{Binding FeedbackTitle}"
                                TextColor="#1E1B18" />
                            <Label
                                FontSize="15"
                                Text="{Binding FeedbackBody}"
                                TextColor="#544B40" />
                            <Border
                                Padding="16"
                                Background="#F3EDE2"
                                Stroke="#D8CCBB"
                                StrokeShape="RoundRectangle 18"
                                IsVisible="{Binding HasExampleSentence}">
                                <VerticalStackLayout Spacing="8">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        Text="Example sentence"
                                        TextColor="#6C6256" />
                                    <Label
                                        FontSize="17"
                                        Text="{Binding ExampleSentenceText}"
                                        TextColor="#1E1B18" />
                                    <Label
                                        FontSize="14"
                                        Text="{Binding ExampleSentenceTranslation}"
                                        TextColor="#645A4E" />
                                </VerticalStackLayout>
                            </Border>
                            <Button
                                Padding="18,12"
                                BackgroundColor="#1D4D4F"
                                Command="{Binding NextCommand}"
                                CornerRadius="18"
                                FontAttributes="Bold"
                                Text="{Binding NextButtonText}"
                                TextColor="#FBF8F2" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Border
                    Margin="0,18,0,0"
                    Padding="24"
                    Background="#FBF8F2"
                    Stroke="#D8CCBB"
                    StrokeShape="RoundRectangle 26"
                    IsVisible="{Binding IsSessionComplete}">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            FontAttributes="Bold"
                            FontSize="28"
                            Text="{Binding CompletionTitle}"
                            TextColor="#1E1B18" />
                        <Label
                            FontSize="16"
                            Text="{Binding CompletionSummary}"
                            TextColor="#544B40" />
                        <Button
                            Padding="18,12"
                            BackgroundColor="#C56E4A"
                            Command="{Binding ReturnToModulesCommand}"
                            CornerRadius="18"
                            FontAttributes="Bold"
                            Text="Back to modules"
                            TextColor="#FFF9F2" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Label
            Grid.Row="3"
            Margin="0,16,0,0"
            FontSize="13"
            HorizontalTextAlignment="Center"
            Text="{Binding ProgressSummary}"
            TextColor="#6C6256" />
    </Grid>
</controls:BasePage>
