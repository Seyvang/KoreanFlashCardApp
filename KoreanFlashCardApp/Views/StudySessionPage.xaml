<?xml version="1.0" encoding="utf-8" ?>
<controls:BasePage
    x:Class="KoreanFlashCardApp.StudySessionPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:KoreanFlashCardApp.Controls"
    xmlns:models="clr-namespace:KoreanFlashCardApp.Models"
    xmlns:viewModels="clr-namespace:KoreanFlashCardApp.ViewModels"
    x:Name="SessionPageRoot"
    x:DataType="viewModels:StudySessionPageViewModel"
    BackgroundColor="{StaticResource AppPaper}"
    Shell.NavBarIsVisible="False">

    <Grid Padding="20,24,20,20" RowDefinitions="Auto,Auto,*,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
            <Button
                Padding="16,10"
                BackgroundColor="{StaticResource AppSurfaceMuted}"
                Command="{Binding ReturnToModulesCommand}"
                CornerRadius="18"
                FontAttributes="Bold"
                Text="Modules"
                TextColor="{StaticResource AppInkSoft}" />
            <VerticalStackLayout
                Grid.Column="1"
                Margin="16,0,0,0"
                Spacing="2">
                <Label
                    FontAttributes="Bold"
                    FontSize="26"
                    Text="{Binding SessionTitle}"
                    TextColor="{StaticResource AppInk}" />
                <Label
                    FontSize="14"
                    Text="{Binding SessionSubtitle}"
                    TextColor="{StaticResource AppTextSubtle}" />
            </VerticalStackLayout>
        </Grid>

        <controls:WordDefinitionHeader
            Grid.Row="1"
            Margin="0,20,0,18"
            IsVisible="{Binding HasCard}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Spacing="18">
                <VerticalStackLayout IsVisible="{Binding HasCard}" Spacing="18">
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="Select the best English definition"
                        TextColor="{StaticResource AppInk}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Options}" Spacing="12">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:FlashCardOption">
                                <Border
                                    Padding="0"
                                    Background="{Binding BackgroundColor}"
                                    Stroke="{Binding BorderColor}"
                                    StrokeShape="RoundRectangle 20">
                                    <Button
                                        Padding="18,16"
                                        BackgroundColor="Transparent"
                                        Command="{Binding BindingContext.SelectOptionCommand, Source={x:Reference SessionPageRoot}}"
                                        CommandParameter="{Binding .}"
                                        FontSize="16"
                                        IsEnabled="{Binding IsEnabled}"
                                        Text="{Binding Text}"
                                        TextColor="{Binding TextColor}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <BoxView
                        Margin="6,4"
                        BackgroundColor="{StaticResource AppDivider}"
                        HeightRequest="1"
                        HorizontalOptions="Fill" />

                    <Button
                        Padding="18,12"
                        BackgroundColor="{StaticResource AppSurfaceMuted}"
                        Command="{Binding SkipWordCommand}"
                        CornerRadius="18"
                        FontAttributes="Bold"
                        Text="I already know this"
                        TextColor="{StaticResource AppInkSoft}" />

                    <Border
                        Padding="18"
                        Background="{StaticResource AppSurfaceBrush}"
                        IsVisible="{Binding ShowFeedback}"
                        Stroke="{StaticResource AppDividerBrush}"
                        StrokeShape="RoundRectangle 22">
                        <VerticalStackLayout Spacing="12">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="{Binding FeedbackTitle}"
                                TextColor="{StaticResource AppInk}" />
                            <Label
                                FontSize="15"
                                Text="{Binding FeedbackBody}"
                                TextColor="{StaticResource AppText}" />
                            <Border
                                Padding="16"
                                Background="{StaticResource AppPaperBrush}"
                                IsVisible="{Binding HasExampleSentence}"
                                Stroke="{StaticResource AppDividerBrush}"
                                StrokeShape="RoundRectangle 18">
                                <VerticalStackLayout Spacing="8">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="13"
                                        Text="Example sentence"
                                        TextColor="{StaticResource AppTextMuted}" />
                                    <Label
                                        FontSize="17"
                                        Text="{Binding ExampleSentenceText}"
                                        TextColor="{StaticResource AppInk}" />
                                    <Label
                                        FontSize="14"
                                        Text="{Binding ExampleSentenceTranslation}"
                                        TextColor="{StaticResource AppTextSubtle}" />
                                </VerticalStackLayout>
                            </Border>
                            <Button
                                Padding="18,12"
                                BackgroundColor="{StaticResource AppPrimary}"
                                Command="{Binding NextCommand}"
                                CornerRadius="18"
                                FontAttributes="Bold"
                                Text="{Binding NextButtonText}"
                                TextColor="{StaticResource AppSurface}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Border
                    Margin="0,18,0,0"
                    Padding="24"
                    Background="{StaticResource AppSurfaceBrush}"
                    IsVisible="{Binding IsSessionComplete}"
                    Stroke="{StaticResource AppDividerBrush}"
                    StrokeShape="RoundRectangle 26">
                    <VerticalStackLayout Spacing="12">
                        <Label
                            FontAttributes="Bold"
                            FontSize="28"
                            Text="{Binding CompletionTitle}"
                            TextColor="{StaticResource AppInk}" />
                        <Label
                            FontSize="16"
                            Text="{Binding CompletionSummary}"
                            TextColor="{StaticResource AppText}" />
                        <Button
                            Padding="18,12"
                            BackgroundColor="{StaticResource AppWarning}"
                            Command="{Binding ReturnToModulesCommand}"
                            CornerRadius="18"
                            FontAttributes="Bold"
                            Text="Back to modules"
                            TextColor="{StaticResource AppTextOnDark}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Label
            Grid.Row="3"
            Margin="0,16,0,0"
            FontSize="13"
            HorizontalTextAlignment="Center"
            Text="{Binding ProgressSummary}"
            TextColor="{StaticResource AppTextMuted}" />
    </Grid>
</controls:BasePage>
