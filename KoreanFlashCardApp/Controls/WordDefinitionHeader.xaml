<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="KoreanFlashCardApp.Controls.WordDefinitionHeader"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:KoreanFlashCardApp.ViewModels"
    x:DataType="viewModels:StudySessionPageViewModel">

    <Border
        Padding="20"
        Background="{StaticResource AppInkBrush}"
        Stroke="{StaticResource AppInkBrush}"
        StrokeShape="RoundRectangle 28">
        <VerticalStackLayout Spacing="10">
            <Grid ColumnDefinitions="Auto,*">
                <Border
                    Padding="10,6"
                    Background="{StaticResource AppSuccessBrush}"
                    Stroke="{StaticResource AppSuccessBrush}"
                    StrokeShape="RoundRectangle 14">
                    <Label
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="{Binding ModuleBadge}"
                        TextColor="{StaticResource AppTextOnSuccess}" />
                </Border>
                <Label
                    Grid.Column="1"
                    FontSize="13"
                    HorizontalTextAlignment="End"
                    Text="{Binding CounterLabel}"
                    TextColor="{StaticResource AppTextOnInkMuted}"
                    VerticalTextAlignment="Center" />
            </Grid>

            <Label
                FontAttributes="Bold"
                FontSize="36"
                Text="{Binding CurrentCard.TargetWord.Word_Name}"
                TextColor="{StaticResource AppTextOnDark}" />

            <Border
                Padding="10,6"
                Background="{StaticResource AppGoldSoftBrush}"
                Stroke="{StaticResource AppGoldSoftBrush}"
                StrokeShape="RoundRectangle 14"
                HorizontalOptions="Start">
                <Label
                    FontSize="12"
                    Text="{Binding WordTypeLabel}"
                    TextColor="{StaticResource AppGoldText}" />
            </Border>

            <Label
                FontSize="15"
                LineBreakMode="WordWrap"
                Text="{Binding WordDefinitionText}"
                TextColor="{StaticResource AppDividerStrong}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
