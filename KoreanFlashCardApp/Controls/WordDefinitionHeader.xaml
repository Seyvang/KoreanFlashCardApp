<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="KoreanFlashCardApp.Controls.WordDefinitionHeader"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:KoreanFlashCardApp.ViewModels"
    x:DataType="viewModels:StudySessionPageViewModel">

    <Border
        Padding="20"
        Background="#1E1B18"
        Stroke="#1E1B18"
        StrokeShape="RoundRectangle 28">
        <VerticalStackLayout Spacing="10">
            <Grid ColumnDefinitions="Auto,*">
                <Border
                    Padding="10,6"
                    Background="#2C7A58"
                    Stroke="#2C7A58"
                    StrokeShape="RoundRectangle 14">
                    <Label
                        FontAttributes="Bold"
                        FontSize="12"
                        Text="{Binding ModuleBadge}"
                        TextColor="#F5FFF7" />
                </Border>
                <Label
                    Grid.Column="1"
                    FontSize="13"
                    HorizontalTextAlignment="End"
                    Text="{Binding CounterLabel}"
                    TextColor="#C9C1B6"
                    VerticalTextAlignment="Center" />
            </Grid>

            <Label
                FontAttributes="Bold"
                FontSize="36"
                Text="{Binding CurrentCard.TargetWord.Word_Name}"
                TextColor="#FFF9F2" />

            <Border
                Padding="10,6"
                Background="#F0E4C6"
                Stroke="#F0E4C6"
                StrokeShape="RoundRectangle 14"
                HorizontalOptions="Start">
                <Label
                    FontSize="12"
                    Text="{Binding WordTypeLabel}"
                    TextColor="#5E461E" />
            </Border>

            <Label
                FontSize="15"
                LineBreakMode="WordWrap"
                Text="{Binding WordDefinitionText}"
                TextColor="#D7D0C5" />
        </VerticalStackLayout>
    </Border>
</ContentView>
